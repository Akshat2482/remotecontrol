<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E14">

    <!-- ============ Connect bar (visible until connected) ============ -->
    <LinearLayout
        android:id="@+id/connectBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#12181F">

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="wss://your-tunnel-url.trycloudflare.com"
            android:textColorHint="#667"
            android:textColor="#FFFFFF"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/tokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="auth token (printed by Jarvis on activation)"
            android:textColorHint="#667"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:singleLine="true" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Connect"
            android:backgroundTint="#00B8D4" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Not connected"
            android:textColor="#889"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ============ Chat pane (top section) ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.42"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:background="#12181F">

            <EditText
                android:id="@+id/chatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Message Jarvis..."
                android:textColorHint="#667"
                android:textColor="#FFFFFF"
                android:inputType="text"
                android:maxLines="3" />

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_send"
                android:background="@android:color/transparent"
                android:contentDescription="Send" />

            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_mic"
                android:background="@android:color/transparent"
                android:contentDescription="Dictate" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#00B8D4" />

    <!-- ============ Screen mirror pane (bottom section) ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.58"
        android:background="#000000">

        <ImageView
            android:id="@+id/screenView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Remote screen" />

        <TextView
            android:id="@+id/screenPlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Screen will appear here once connected"
            android:textColor="#556"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
